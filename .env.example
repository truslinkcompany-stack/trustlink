# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# ТОЛЬКО на сервере. Никогда не добавляйте префикс NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Публичный адрес сайта (для ссылок в QR). Пример: https://trustlink.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Секрет для токена скачивания PDF (любая длинная случайная строка, например: openssl rand -hex 32)
PDF_TOKEN_SECRET=
# Показывать фото на публичной странице проверки (по умолчанию нет)
SHOW_PHOTO_ON_VERIFY=false
# Показывать блок «При поддержке» (после разрешения организаторов + файлы в public/partners/)
NEXT_PUBLIC_SHOW_PARTNERS=false
